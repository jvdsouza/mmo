# Development Environment Configuration

# Server
ENVIRONMENT=development
PORT=8080
TICK_RATE=20
MAX_PLAYERS=100

# CORS (allow all in dev)
ENABLE_CORS=true

# Logging
LOG_LEVEL=debug

# Database (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mmo_dev
DB_USER=postgres
DB_PASSWORD=dev_password

# Redis (for future session management)
REDIS_HOST=localhost
REDIS_PORT=6379

# Features (enable all in dev)
ENABLE_COMBAT=true
ENABLE_CHAT=true
ENABLE_PVP=true
SPAWN_TEST_MONSTERS=true
