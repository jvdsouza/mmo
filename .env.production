# Production Environment Configuration

# Server
ENVIRONMENT=production
PORT=8080
TICK_RATE=20
MAX_PLAYERS=10000

# CORS
ENABLE_CORS=false
ALLOWED_ORIGINS=https://yourgame.com,https://www.yourgame.com

# Logging
LOG_LEVEL=warn

# Database
DB_HOST=prod-db.yourgame.com
DB_PORT=5432
DB_NAME=mmo_production
DB_USER=mmo_user
DB_PASSWORD=USE_SECRETS_MANAGER

# Redis
REDIS_HOST=prod-redis.yourgame.com
REDIS_PORT=6379

# Features
ENABLE_COMBAT=true
ENABLE_CHAT=true
ENABLE_PVP=true
SPAWN_TEST_MONSTERS=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
