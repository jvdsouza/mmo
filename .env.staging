# Staging Environment Configuration

# Server
ENVIRONMENT=staging
PORT=8080
TICK_RATE=20
MAX_PLAYERS=500

# CORS
ENABLE_CORS=false
ALLOWED_ORIGINS=https://staging.yourgame.com

# Logging
LOG_LEVEL=info

# Database
DB_HOST=staging-db.yourgame.com
DB_PORT=5432
DB_NAME=mmo_staging
DB_USER=mmo_user
DB_PASSWORD=CHANGE_ME_IN_SECRETS

# Redis
REDIS_HOST=staging-redis.yourgame.com
REDIS_PORT=6379

# Features
ENABLE_COMBAT=true
ENABLE_CHAT=true
ENABLE_PVP=true
SPAWN_TEST_MONSTERS=false
